# Copy to apps/api/.env. Validated at boot by src/config/env.schema.ts.
NODE_ENV=development
PORT=4000

# Comma-separated origins allowed by CORS (the Next.js app runs on 3000).
CORS_ORIGINS=http://localhost:3000

# Must match infra/.env (pnpm infra:up).
DATABASE_URL=postgresql://classflow:change-me@localhost:5432/classflow
RABBITMQ_URL=amqp://classflow:change-me@localhost:5672/classflow
