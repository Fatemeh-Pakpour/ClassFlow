# Copy to apps/web/.env.local. Values come from the Auth0 "classFlow Web" application.

# Long random string that encrypts the session cookie: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Tenant domain without https://, e.g. classflow.eu.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Identifier of the Auth0 API; must match AUTH0_AUDIENCE in apps/api/.env.
AUTH0_AUDIENCE=https://api.classflow.local
