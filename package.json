{
  "name": "classflow",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "pnpm --filter @classflow/db build",
    "dev:web": "pnpm --filter @classflow/web dev",
    "build:web": "pnpm --filter @classflow/web build",
    "start:web": "pnpm --filter @classflow/web start",
    "dev:api": "pnpm --filter @classflow/api dev",
    "build:api": "pnpm --filter @classflow/api build",
    "start:api": "pnpm --filter @classflow/api start:prod",
    "db:generate": "pnpm --filter @classflow/db db:generate",
    "db:migrate": "pnpm --filter @classflow/db db:migrate",
    "db:check": "pnpm --filter @classflow/db db:check",
    "db:studio": "pnpm --filter @classflow/db db:studio",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "infra:ps": "docker compose -f infra/compose.yaml ps",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
