# Used by drizzle-kit (generate/migrate/studio). Must match infra/.env.
DATABASE_URL=postgresql://classflow:change-me@localhost:5433/classflow

# Integration tests (pnpm test:integration) connect here only to create and drop
# their own classflow_test_* databases. Needs CREATEDB; never point at production.
TEST_DATABASE_ADMIN_URL=postgresql://classflow:change-me@localhost:5433/postgres
