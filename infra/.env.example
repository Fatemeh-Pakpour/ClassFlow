# Copy to infra/.env and adjust. infra/.env is git-ignored; never commit real secrets.

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=classflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=classflow
POSTGRES_PORT=5432

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=classflow
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=classflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Connection strings for the apps (api / worker) ──────────
# DATABASE_URL=postgresql://classflow:change-me@localhost:5432/classflow
# RABBITMQ_URL=amqp://classflow:change-me@localhost:5672/classflow
